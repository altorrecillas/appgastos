{
  "name": "GastosbyATH · Las cuentas de casa",
  "short_name": "GastosbyATH",
  "description": "Gastos, facturas, pagos fijos, compras a plazos, compra y mascotas del hogar.",
  "lang": "es",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f2f4f8",
  "theme_color": "#1d3aa5",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/logo.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Anotar gasto", "url": "/#/nuevo", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Foto del ticket", "url": "/#/nuevo?ticket=1", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Lista de la compra", "url": "/#/compra", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
